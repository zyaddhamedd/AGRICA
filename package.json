{
  "name": "agrica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:catalogue": "tsx test/catalogue.test.ts",
    "test:products": "tsx test/products.test.ts",
    "test:i18n": "tsx test/i18n.test.ts",
    "test:routing": "tsx test/routing.test.ts && tsx test/divisions.test.ts",
    "test:phase0": "npm run test:i18n && npm run test:catalogue && npm run test:products && npm run test:herbs-spices && npm run test:herbs-spices-process",
    "test:phase1": "npm run test:phase0 && npm run test:routing",
    "test:phase2": "npm run test:phase1",
    "test:phase3a": "npm run test:phase2 && tsx test/phase3a.test.ts",
    "test:phase3b": "npm run test:phase3a && tsx test/phase3b.test.ts",
    "test:phase0-browser": "node test/phase0-browser.test.mjs",
    "test:phase1-browser": "node test/phase1-browser.test.mjs",
    "test:phase2-browser": "node test/phase2-browser.test.mjs",
    "test:phase3a-browser": "node test/phase3a-browser.test.mjs",
    "test:phase3b-browser": "node test/phase3b-browser.test.mjs",
    "test:products-browser": "node test/products-browser.test.mjs",
    "test:herbs-spices": "tsx test/herbs-spices-catalogue.test.ts",
    "test:herbs-spices-process": "tsx test/herbs-spices-process.test.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
